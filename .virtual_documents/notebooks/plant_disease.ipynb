### let's create a ensenble
def buliding_weight(models, input_shape, weights):
    input_layer = Input(shape=input_shape, name="input_image")
    out_1 = models[0](input_layer)
    out_2 = models[1](input_layer)
    
    scaled_1 = out_1 * weights[0] 
    scaled_2 = out_2 * weights[1] 
    
    
    ensemble_output = Add()([scaled_1, scaled_2])
    

    ensemble_model = tf.keras.models.Model(inputs=input_layer, outputs=ensemble_output, name="Farmer_AI_Ensemble")
    
    return ensemble_model


