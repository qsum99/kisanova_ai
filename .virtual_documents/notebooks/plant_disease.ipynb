### model evaluation
def evaluation(model, test_gen,model_name="Model"):
    loss,acc=model.evaluate(test_gen,verbose=1)
    print(f"model:{model_name}----> test accracy:{acc}---->test loss:{loss}")
    y_pred=model.predict(test_gen)
    y_pred_arg=np.argmax(y_pred,axis=1)
    y_ture=test_gen.classes
    class_name=list(test_gen.class_indices.keys())

    print("class report")
    print(classification_report(y_ture,y_pred_arg,target_names=class_name))


