def evaluate_model_performance(model, test_gen, name):
    y_pred = model.predict(test_gen, verbose=0)
    y_pred_arg = np.argmax(y_pred, axis=1)
    y_ture = test_gen.classes
    class_name = list(test_gen.class_indices.keys())

    acc = accuracy_score(y_ture, y_pred_arg)
    f1 = f1_score(y_ture, y_pred_arg, average="macro")
    pre = precision_score(y_ture, y_pred_arg, average="macro")
    recal = recall_score(y_ture, y_pred_arg, average="macro")

    return {
        "Model": name,
        "Accuracy": acc,
        "F1": f1,
        "Precision": pre,
        "Recall": recal,
        "y_true": y_ture,
        "y_pred": y_pred_arg
    }


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

def ploting_dishboard(results_list):
    df = pd.DataFrame(results_list)
    df_for_plot = df.drop(columns=["y_true", "y_pred"])
    df_melt = df_for_plot.melt(id_vars="Model", var_name="Metric", value_name="Score")
    df_melt['Score'] = df_melt['Score'].astype(float)

    plt.figure(figsize=(10, 7))
    sns.barplot(x="Model", y="Score", hue="Metric", data=df_melt)
    
    plt.title("Model Performance Comparison", fontsize=14, fontweight='bold')
    plt.xticks(rotation=15)
    plt.ylim(0, 1.1)
    plt.yticks([i/20 for i in range(21)])

    plt.legend() 
    
    plt.tight_layout()
    plt.show()
    


