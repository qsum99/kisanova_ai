model=tf.keras.models.load_model("ensemble_model.keras")
inputs=tf.keras.Input(shape=(224,224,3),name="input_image")
x=model(inputs)
func_model=tf.keras.Model(inputs=inputs,outputs=x,name="efficient")
spec = [tf.TensorSpec((None, 224, 224, 3), tf.float32, name="input_image")]

model_proto, _ =tf2onnx.convert.from_keras(func_model,input_signature=spec,opset=13)

with open("ensemble_model_final.onnx","wb") as f:
    f.write(model_proto.SerializeToString())
